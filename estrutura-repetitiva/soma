#include <stdio.h>

int main(){
    int i, N, x, soma;

    printf("Quantos numeros voce vai digitar? ");
    scanf("%d", &N);

    soma = 0;
    for(i=0; i<=N; i++){
        printf("Digite um numero: ");
        scanf("%d", &x);
        soma += x;
    }

    printf("A soma dos numeros digitados e: %d", soma);
    return 0;
    
    return 0;
}
